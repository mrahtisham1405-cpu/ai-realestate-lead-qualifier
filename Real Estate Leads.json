    {
      "parameters": {
        "jsCode": "const text = $json.content?.parts?.[0]?.text || \"\";\n\n// Clean Markdown backticks\nlet cleanText = text\n  .replace(/```json/gi, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet aiResult;\n\ntry {\n  aiResult = JSON.parse(cleanText);\n} catch (error) {\n  throw new Error(\"AI response is not valid JSON: \" + text);\n}\n\n// Fetch original lead data from 'Detect Duplicate' node\nconst lead = $('Detect Duplicate').first().json;\n\nreturn [\n  {\n    json: {\n      lead_id: lead.Lead_id || lead.lead_id,\n      name: lead.name,\n      email: lead.email,\n      phone: lead.phone,\n      property_type: lead.property_type,\n      location: lead.location,\n      budget: lead.budget,\n      purpose: lead.purpose,\n      message: lead.message,\n\n      lead_score: Number(aiResult.lead_score || 0),\n      lead_status: aiResult.lead_status || aiResult.score,\n      reason: aiResult.reason || aiResult.reasoning,\n\n      created_at: new Date().toISOString()\n    }\n  }\n];"
