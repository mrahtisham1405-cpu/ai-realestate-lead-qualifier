      "parameters": {
        "jsCode": "const lead = $json.body;\n\nconst errors = [];\n\nif (!lead.name || lead.name.trim() === \"\") {\n  errors.push(\"Name is required\");\n}\n\nif (!lead.email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) {\n  errors.push(\"Valid email is required\");\n}\n\nif (!lead.phone || !/^\\+?[0-9]{10,15}$/.test(lead.phone.replace(/[\\s-()-]/g, \"\"))) {\n  errors.push(\"Valid phone number is required\");\n}\n\nif (!lead.property_type || lead.property_type.trim() === \"\") {\n  errors.push(\"Property type is required\");\n}\n\nif (!lead.location || lead.location.trim() === \"\") {\n  errors.push(\"Location is required\");\n}\n\nif (!lead.budget || isNaN(Number(lead.budget)) || Number(lead.budget) <= 0) {\n  errors.push(\"Valid budget is required\");\n}\n\nif (!lead.purpose || lead.purpose.trim() === \"\") {\n  errors.push(\"Purpose is required\");\n}\n\nreturn {\n  json: {\n    lead_id: `L${Date.now()}`,\n    name: lead.name?.trim(),\n    email: lead.email?.trim().toLowerCase(),\n    phone: lead.phone?.replace(/[\\s-()-]/g, \"\"),\n    property_type: lead.property_type?.trim(),\n    location: lead.location?.trim(),\n    budget: Number(lead.budget),\n    purpose: lead.purpose?.trim(),\n    message: lead.message?.trim() || \"\",\n    is_valid: errors.length === 0,\n    errors: errors\n  }\n};"
      },
