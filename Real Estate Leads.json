      "parameters": {
        "jsCode": "const existingLeads = $input.all().map(item => item.json);\n\n// Validation node ka output = new incoming lead\nconst newLead = $('Validate Lead').first().json;\n\n// Normalize email\nfunction normalizeEmail(email) {\n  if (!email) return null;\n  return String(email).trim().toLowerCase();\n}\n\n// Normalize Pakistani phone numbers\nfunction normalizePhone(phone) {\n  if (!phone) return null;\n\n  let p = String(phone).replace(/\\D/g, '');\n\n  // 92xxxxxxxxxx → 03xxxxxxxxx\n  if (p.startsWith('92')) {\n    p = '0' + p.substring(2);\n  }\n\n  // 3xxxxxxxxx → 03xxxxxxxxx\n  if (p.startsWith('3') && p.length === 10) {\n    p = '0' + p;\n  }\n\n  return p;\n}\n\n// Normalize name\nfunction normalizeName(name) {\n  if (!name) return null;\n  return String(name).trim().toLowerCase().replace(/\\s+/g, ' ');\n}\n\nconst newEmail = normalizeEmail(newLead.email);\nconst newPhone = normalizePhone(newLead.phone);\nconst newName = normalizeName(newLead.name);\n\nlet duplicate = false;\nlet duplicateType = null;\nlet matchedLead = null;\n\n// 1. Email check — highest priority\nif (newEmail) {\n  matchedLead = existingLeads.find(lead =>\n    normalizeEmail(lead.Email) === newEmail\n  );\n\n  if (matchedLead) {\n    duplicate = true;\n    duplicateType = 'email';\n  }\n}\n\n// 2. Phone check\nif (!duplicate && newPhone) {\n  matchedLead = existingLeads.find(lead =>\n    normalizePhone(lead.Phone) === newPhone\n  );\n\n  if (matchedLead) {\n    duplicate = true;\n    duplicateType = 'phone';\n  }\n}\n\n// 3. Name check\nif (!duplicate && newName) {\n  matchedLead = existingLeads.find(lead =>\n    normalizeName(lead.Name) === newName\n  );\n\n  if (matchedLead) {\n    duplicate = true;\n    duplicateType = 'name';\n  }\n}\n\nreturn [\n  {\n    json: {\n      ...newLead,\n      is_duplicate: duplicate,\n      duplicate_match: duplicateType,\n      matched_lead_id: matchedLead?.Lead_ID || null\n    }\n  }\n];"
      },
